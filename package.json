{
  "name": "yuucomments",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.9",
  "scripts": {
    "dev": "wrangler dev --config worker/wrangler.toml",
    "deploy": "wrangler deploy --config worker/wrangler.toml",
    "deploy:backend": "tsx scripts/deploy-backend.ts",
    "setup": "node ./worker/setup.js",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply yuucomments-db --local --config worker/wrangler.toml",
    "db:migrate:remote": "wrangler d1 migrations apply yuucomments-db --remote --config worker/wrangler.toml"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260515.0",
    "@types/node": "^22.15.18",
    "tsx": "^4.19.4",
    "typescript": "^5.9.3",
    "wrangler": "^4.17.0"
  }
}
