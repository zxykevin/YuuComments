---
interface Props {
  pageKey?: string;
  theme?: "light" | "dark";
  lang?: "zh-CN" | "en";
  markdown?: boolean;
  math?: boolean;
}

const {
  pageKey = Astro.url.pathname,
  theme = "light",
  lang = "zh-CN",
  markdown = true,
  math = true,
} = Astro.props;
---

<div
  id="yuucomments-iframe"
  data-page-key={pageKey}
  data-src="/comments/embed.html"
  data-theme={theme}
  data-lang={lang}
  data-markdown={String(markdown)}
  data-math={String(math)}
></div>

<script src="/comments/yuucomments-embed.js" defer></script>
