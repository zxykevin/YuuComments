name = "yuucomments"
main = "src/index.ts"
compatibility_date = "2026-05-16"
[[d1_databases]]
binding = "DB"
database_name = "yuucomments-db"
database_id = "replace-with-your-d1-database-id"
migrations_dir = "migrations"

[secrets]
required = ["ADMIN_TOKEN", "TURNSTILE_SECRET_KEY"]

# Add the Turnstile secret with:
# npx wrangler secret put TURNSTILE_SECRET_KEY
